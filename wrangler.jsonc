{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hesedbeautystudio",
  "compatibility_date": "2026-09-17",
  "main": "src/worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/index", "/index.html", "/tratamientos/*", "/api/*", "/videos/*"]
  },
  "d1_databases": [
    {
      "binding": "BOOKINGS_DB",
      "database_name": "mariahesed-bookings",
      "database_id": "7385fe1e-f2ab-499d-a865-9b41c5c10e25"
    }
  ],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "mariahesed.com",
      "custom_domain": true
    },
    {
      "pattern": "www.mariahesed.com",
      "custom_domain": true
    }
  ]
}
