{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hesedbeautystudio",
  "compatibility_date": "2026-09-17",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "mariahesed.com",
      "custom_domain": true
    },
    {
      "pattern": "www.mariahesed.com",
      "custom_domain": true
    }
  ]
}
